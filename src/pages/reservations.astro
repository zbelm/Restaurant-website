---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Confirmation from '../components/Confirmation.astro';
import site from '../content/site.json';
import { hours, fmtRanges } from '../lib/format';

const slots = ['5:00 pm', '5:30 pm', '6:00 pm', '6:30 pm', '7:00 pm', '7:30 pm', '8:00 pm', '8:30 pm', '9:00 pm'];
const closedDays = hours.filter((d) => d.closed).map((d) => d.day);
const external = site.links.reserveExternal;
---

<Base title="Reserve a Table" description={`Reserve a table at ${site.name}. Book online in under a minute, or call ${site.contact.phone}.`} hideMobileBar>
  <PageHeader eyebrow="Reservations" title="Save your <em>seat.</em>" lead="Book a table in under a minute. For parties of 9 or more, please call us or send a private dining enquiry." art={[{ kind: 'interior', tone: 'night' }, { kind: 'spritz', tone: 'gold' }]} />

  <section class="section res">
    <div class="container grid">
      <div class="card" data-reveal>
        <form id="res-form" novalidate data-closed={JSON.stringify(closedDays)} aria-label="Reservation form">
          <div class="form-grid">
            <div class="field" data-field="name"><label for="r-name">Full name</label><input class="input" id="r-name" name="name" autocomplete="name" placeholder="Alex Rivera" required /><span class="error" role="alert"></span></div>
            <div class="field" data-field="email"><label for="r-email">Email</label><input class="input" id="r-email" name="email" type="email" autocomplete="email" placeholder="you@email.com" required /><span class="error" role="alert"></span></div>
            <div class="field" data-field="phone"><label for="r-phone">Phone</label><input class="input" id="r-phone" name="phone" type="tel" autocomplete="tel" placeholder="(555) 123-4567" required /><span class="error" role="alert"></span></div>
            <div class="field" data-field="date"><label for="r-date">Date</label><input class="input" id="r-date" name="date" type="date" required /><span class="error" role="alert"></span></div>

            <div class="field full">
              <span class="label" id="size-l">Party size</span>
              <div class="stepper" role="group" aria-labelledby="size-l">
                <button type="button" class="step" data-step="-1" aria-label="Fewer guests">−</button>
                <output class="size" name="sizeOut" for="r-size" aria-live="polite"><b data-size>2</b> <span data-size-l>guests</span></output>
                <button type="button" class="step" data-step="1" aria-label="More guests">+</button>
                <input type="hidden" id="r-size" name="size" value="2" />
              </div>
            </div>

            <div class="field full" data-field="time">
              <span class="label" id="time-l">Time</span>
              <div class="slots" role="radiogroup" aria-labelledby="time-l">
                {slots.map((s, i) => (
                  <label class="slot"><input type="radio" name="time" value={s} required /><span>{s}</span></label>
                ))}
              </div>
              <span class="error" role="alert"></span>
            </div>

            <div class="field full"><label for="r-notes">Special requests <span class="opt">(optional)</span></label><textarea class="input" id="r-notes" name="notes" placeholder="Allergies, celebrations, high chairs…"></textarea></div>
            <div class="hp" aria-hidden="true"><label>Leave blank<input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <div class="full"><button class="btn" type="submit">Request reservation <span class="arrow" aria-hidden="true">→</span></button></div>
          </div>
        </form>

        <Confirmation title="You’re <em>almost</em> in!" id="res-done">
          <p>Thanks, <b data-o="name"></b>. We’ve got your request and will confirm by email shortly.</p>
          <dl>
            <dt>When</dt><dd data-o="when"></dd>
            <dt>Party</dt><dd data-o="party"></dd>
            <dt>Where</dt><dd>{site.address.street}, {site.address.city}</dd>
          </dl>
          <Fragment slot="actions">
            <button type="button" class="btn" data-ics>Add to calendar</button>
            <a class="btn btn--ghost" href="/menu">Peek at the menu</a>
          </Fragment>
        </Confirmation>
      </div>

      <aside class="side" data-stagger="120">
        <div class="box" data-reveal>
          <h2 class="h3">Hours</h2>
          <ul class="hours-list">{hours.map((d) => (<li data-day={d.day}><span>{d.day}</span><span class="time">{fmtRanges(d)}</span></li>))}</ul>
        </div>
        <div class="box dark on-dark" data-reveal>
          <h2 class="h3">Larger party or a quick question?</h2>
          <p class="muted">Call us and we’ll sort it out together.</p>
          <a class="btn btn--light" href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
        </div>
        <div class="box" data-reveal>
          <h2 class="h3">Good to know</h2>
          <ul class="know">
            <li>Tables are held for 15 minutes.</li>
            <li>Walk-ins welcome at the bar.</li>
            <li>Parties of 6+ have a 20% service charge.</li>
            <li>Kids and dogs (patio only) welcome.</li>
          </ul>
        </div>
        {external && <a class="link-arrow" href={external} target="_blank" rel="noopener" data-reveal>Prefer OpenTable? <span aria-hidden="true">→</span></a>}
      </aside>
    </div>
  </section>
</Base>

<script>
  import { attachForm } from '../scripts/forms';

  const form = document.getElementById('res-form') as HTMLFormElement;
  const done = document.getElementById('res-done')!;
  const closed: string[] = JSON.parse(form.dataset.closed ?? '[]');
  const dateInput = form.elements.namedItem('date') as HTMLInputElement;
  const sizeInput = form.elements.namedItem('size') as HTMLInputElement;
  const sizeEl = form.querySelector('[data-size]')!;
  const sizeL = form.querySelector('[data-size-l]')!;

  // earliest bookable date = today (local)
  const today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  dateInput.min = today.toISOString().slice(0, 10);
  const max = new Date(today); max.setMonth(max.getMonth() + 3); dateInput.max = max.toISOString().slice(0, 10);

  const setSize = (n: number) => {
    n = Math.max(1, Math.min(8, n));
    sizeInput.value = String(n); sizeEl.textContent = String(n); sizeL.textContent = n === 1 ? 'guest' : 'guests';
    form.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = n <= 1;
    form.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = n >= 8;
    sizeEl.animate([{ transform: 'translateY(-8px)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 300, easing: 'ease-out' });
  };
  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => setSize(Number(sizeInput.value) + Number(b.dataset.step))));
  setSize(2);

  const dayName = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long' });
  let last: Record<string, string> = {};

  attachForm(
    form,
    (data) => {
      // TODO: send `data` to your backend / form service here (see README).
      last = data;
      const pretty = new Date(data.date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
      done.querySelector('[data-o=name]')!.textContent = data.name.split(' ')[0];
      done.querySelector('[data-o=when]')!.textContent = `${pretty} at ${data.time}`;
      done.querySelector('[data-o=party]')!.textContent = `${data.size} ${Number(data.size) === 1 ? 'guest' : 'guests'}`;
      form.hidden = true; done.hidden = false; done.focus();
      done.scrollIntoView({ behavior: 'smooth', block: 'center' });
    },
    (name) => {
      if (name === 'date' && closed.includes(dayName(dateInput.value))) return `We’re closed on ${dayName(dateInput.value)}s. Please pick another day.`;
      return null;
    },
  );

  // "Add to calendar" (.ics download, generated in the browser)
  done.querySelector('[data-ics]')?.addEventListener('click', () => {
    const [t, ap] = last.time.split(' ');
    let [h, m] = t.split(':').map(Number); if (ap === 'pm' && h !== 12) h += 12;
    const pad = (n: number) => String(n).padStart(2, '0');
    const d = last.date.replace(/-/g, '');
    const start = `${d}T${pad(h)}${pad(m)}00`;
    const end = `${d}T${pad(h + 2)}${pad(m)}00`;
    const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Zippies//Reservation//EN', 'BEGIN:VEVENT', `UID:${Date.now()}@zippies`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').slice(0, 15)}Z`, `DTSTART:${start}`, `DTEND:${end}`, 'SUMMARY:Dinner at Zippies', 'LOCATION:482 Marigold Lane\\, Riverton\\, CA 90210', `DESCRIPTION:Table for ${last.size}`, 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
    a.download = 'zippies-reservation.ics'; a.click(); URL.revokeObjectURL(a.href);
  });
</script>

<style>
  .res { background: linear-gradient(var(--cream), var(--cream-2)); }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .card { background: var(--paper); border-radius: var(--radius-lg); padding: clamp(24px, 4vw, 52px); box-shadow: var(--shadow-lift); }
  form.shake { animation: shake 0.45s; }
  @keyframes shake { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }
  .stepper { display: inline-flex; align-items: center; gap: 6px; background: #fff; border: 1.5px solid var(--cream-3); border-radius: 999px; padding: 6px; width: fit-content; }
  .step { width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--cream-2); font-size: 1.4rem; line-height: 1; transition: background 0.3s, color 0.3s, transform 0.3s var(--ease); }
  .step:hover:not(:disabled) { background: var(--tomato); color: #fff; transform: scale(1.08); }
  .step:disabled { opacity: 0.35; cursor: not-allowed; }
  .size { min-width: 120px; text-align: center; font-weight: 500; }
  .size b { font-family: var(--font-display); font-size: 1.6rem; font-weight: 500; display: inline-block; }
  .slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 10px; }
  .slot { position: relative; cursor: pointer; }
  .slot input { position: absolute; opacity: 0; inset: 0; }
  .slot span { display: grid; place-items: center; padding: 12px 8px; border-radius: 14px; background: #fff; border: 1.5px solid var(--cream-3); font-weight: 500; font-size: 0.95rem; transition: all 0.3s var(--ease); text-transform: none; letter-spacing: 0; color: var(--ink); }
  .slot:hover span { border-color: var(--olive-800); transform: translateY(-2px); }
  .slot input:checked + span { background: var(--olive-900); color: var(--cream); border-color: var(--olive-900); transform: translateY(-2px); box-shadow: 0 10px 18px -8px rgb(31 42 28 / 0.6); }
  .slot input:focus-visible + span { outline: 3px solid var(--tomato-bright); outline-offset: 2px; }
  .side { display: grid; gap: 20px; position: sticky; top: calc(var(--nav-h) + 20px); }
  .box { background: var(--paper); border-radius: var(--radius); padding: 28px; border: 1px solid var(--line); }
  .box.dark { background: var(--olive-900); border-color: transparent; display: grid; gap: 14px; justify-items: start; }
  .box.dark p { margin: 0; }
  .box .h3 { margin-bottom: 14px; }
  .know { display: grid; gap: 10px; }
  .know li { padding-left: 26px; position: relative; font-size: 0.97rem; }
  .know li::before { content: '✺'; position: absolute; left: 0; color: var(--tomato); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } .side { position: static; } }
</style>
