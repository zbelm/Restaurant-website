const body = shapes[kind] ?? shapes.pasta;
---

{
  src ? (
    <img class:list={['art', cls]} src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <div class:list={['art', `art--${tone}`, cls]} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
      <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
        <Fragment set:html={body} />
      </svg>
    </div>
  )
}

<style is:global>
  .art { position: relative; width: 100%; height: 100%; overflow: hidden; display: block; object-fit: cover; }
  .art svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .art::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / .16), transparent 60%),
      radial-gradient(100% 80% at 50% 120%, rgb(0 0 0 / .22), transparent 60%);
  }
  .art--olive { background: linear-gradient(145deg, #5D7550, #2F3A2B); }
  .art--terracotta { background: linear-gradient(145deg, #E2755A, #A93C26); }
  .art--cream { background: linear-gradient(145deg, #F9F0DD, #E7D6B3); }
  .art--gold { background: linear-gradient(145deg, #E8C97F, #BE8F3F); }
  .art--night { background: linear-gradient(145deg, #3A4A36, #161C14); }
  .art .steam path { animation: steam 3.2s ease-in-out infinite; transform-box: fill-box; }
  .art .steam path:nth-child(2) { animation-delay: .6s; }
  .art .steam path:nth-child(3) { animation-delay: 1.2s; }
  @keyframes steam { 0%,100% { opacity: .2; transform: translateY(6px); } 50% { opacity: .85; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .art .steam path { animation: none; } }
</style>
