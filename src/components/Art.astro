---
/**
 * Illustrated food/venue art used as image placeholders.
 * To use a real photo instead, pass `src` (and `alt`) — the illustration is skipped.
 * Drop photos in /public/images and reference them as "/images/your-photo.jpg".
 */
interface Props {
  kind?: string;
  tone?: 'olive' | 'terracotta' | 'cream' | 'gold' | 'night';
  src?: string;
  alt?: string;
  class?: string;
  eager?: boolean;
}
